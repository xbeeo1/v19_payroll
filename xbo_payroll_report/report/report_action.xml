<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="paperformat_employee_payslip_landscape" model="report.paperformat">
            <field name="name">Employee payslip Landscape</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">450</field>
            <field name="page_width">380</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">26</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">25</field>
            <field name="dpi">90</field>
        </record>







        <record id="action_employee_payslip_report" model="ir.actions.report">
            <field name="name">Employee Payslip Report</field>
            <field name="model">hr.payslip</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">xbo_payroll_report.employee_payslip_report_template</field>
            <field name="report_file">xbo_payroll_report.employee_payslip_report_template</field>
            <field name="paperformat_id" ref="paperformat_employee_payslip_landscape"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Employee Payslip'</field>
        </record>


        <record id="paperformat_employee_pf_landscape" model="report.paperformat">
            <field name="name">Employee PF Landscape</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">450</field>
            <field name="page_width">380</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">26</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">25</field>
            <field name="dpi">90</field>
        </record>




        <record id="action_employee_pf_report" model="ir.actions.report">
            <field name="name">Employee Provident Fund Report</field>
            <field name="model">provident.fund.detail.lines</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">xbo_payroll_report.employee_pf_report_template</field>
            <field name="report_file">xbo_payroll_report.employee_pf_report_template</field>
            <field name="paperformat_id" ref="paperformat_employee_pf_landscape"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Employee PF Report'</field>
        </record>



    </data>
</odoo>