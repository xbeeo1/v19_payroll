<odoo>

    <data>

        <record id="provident_fund_profit_wizard_form_view" model="ir.ui.view">
            <field name="name">provident.fund.profit.wizard.form</field>
            <field name="model">provident.fund.profit</field>
            <field name="arch" type="xml">
                <form string="Provident Fund Profit">
                    <sheet>
                        <group>
                            <group>
                                <field name="date_from"/>
                                <field name="profit_amount"/>
                            </group>
                            <group>
                                <field name="date_to"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Confirm" name="action_confirm" type="object" class="oe_highlight" data-hotkey="q"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="provident_fund_profit_wizard_window_act" model="ir.actions.act_window">
            <field name="name">Provident Fund Profit</field>
            <field name="res_model">provident.fund.profit</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="provident_fund_profit_wizard_form_view"/>
            <field name="target">new</field>
        </record>



        <menuitem id="menu_provident_fund_profit"
              name="Provident Fund Profit"
              action="provident_fund_profit_wizard_window_act"
              parent="xbo_payroll_custom.menu_payroll_operation"
              sequence="10"/>



    </data>

</odoo>