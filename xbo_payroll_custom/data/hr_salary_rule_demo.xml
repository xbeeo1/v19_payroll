<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Demo data: Define a salary rule  for loans -->
        <record id="hr_rule_loan" model="hr.salary.rule">
            <field name="code">LO</field>
            <field name="name">Loan</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -(contract.loan_calculation(payslip))</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="sequence" eval="190"/>
        </record>


        <record id="hr_rule_loan_against_pf" model="hr.salary.rule">
            <field name="code">LOPF</field>
            <field name="name">Loan Against Provident Fund</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -(contract.loan_pf_calculation(payslip))</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="sequence" eval="180"/>
        </record>

        <record id="hr_rule_loan_against_as" model="hr.salary.rule">
            <field name="code">LOAS</field>
            <field name="name">Advance Against Salary</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = -(contract.loan_as_calculation(payslip))</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="sequence" eval="185"/>
        </record>

        <record id="hr_rule_pto" model="hr.salary.rule">
            <field name="code">PTO</field>
            <field name="name">Paid Time Off</field>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.pto_calculation('LEAVE120',payslip)</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="sequence" eval="14"/>
        </record>

