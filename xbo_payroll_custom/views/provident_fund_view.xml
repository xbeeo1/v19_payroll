<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_provident_fund_tree" model="ir.ui.view">
            <field name="name">provident.fund.list</field>
            <field name="model">provident.fund</field>
            <field name="arch" type="xml">
                <list string="Provident Fund" create="false" edit="false" delete='false' >
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="employee_contribution"/>
                    <field name="pf_percentage"/>
                    <field name="employer_contribution"/>
                    <field name="total_PF_period"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_provident_fund_form" model="ir.ui.view">
            <field name="name">provident.fund.form</field>
            <field name="model">provident.fund</field>
            <field name="arch" type="xml">
                <form string="Provident Fund" create="false" edit="false" delete='false'>
                    <header>

                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="creation_date"/>
                                <field name="date_from"/>
                                <field name="payslip_id"/>
                                <field name="salary_amount"/>
                                <field name="employee_contribution"/>
                                <field name="total_PF_period"/>
                            </group>
                            <group>
                                <field name="employee_id"/>
                                <field name="date_to"/>
                                <field name="department_id"/>
                                <field name="pf_percentage"/>
                                <field name="employer_contribution"/>
                            </group>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_provident_fund_filter" model="ir.ui.view">
            <field name="name">provident.fund.search</field>
            <field name="model">provident.fund</field>
            <field name="arch" type="xml">
                <search string="Search Provident Fund">
                    <field name="employee_id"/>
                    <field name="state"/>
                </search>
            </field>
        </record>

        <record id="act_provident_fund" model="ir.actions.act_window">
            <field name="res_model">provident.fund</field>
            <field name="name">Provident Fund</field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem id="menu_provident_fund"
                  action="act_provident_fund"
                  parent="xbo_payroll_custom.menu_payroll_operation"/>







    </data>
</odoo>