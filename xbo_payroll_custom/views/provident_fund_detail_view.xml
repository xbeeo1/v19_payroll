<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_provident_fund_detail_tree" model="ir.ui.view">
            <field name="name">provident.fund.detail.list</field>
            <field name="model">provident.fund.detail</field>
            <field name="arch" type="xml">
                <list string="Provident Fund Detail" create="false" edit="false" delete='false' >
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="creation_date"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_provident_fund_detail_form" model="ir.ui.view">
            <field name="name">provident.fund.detail.form</field>
            <field name="model">provident.fund.detail</field>
            <field name="arch" type="xml">
                <form string="Provident Fund Detail" create="false" edit="false" delete='false'>
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="creation_date"/>
                                <field name="department_id"/>

                            </group>
                            <group>
                                <field name="employee_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines" readonly="1">
                            <field name="provident_fund_detail_lines_ids" readonly="1">
                                <list string="lines">
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="payslip_id"/>
                                    <field name="salary_amount"/>
                                    <field name="pf_percentage"/>
                                    <field name="employee_contribution" sum="Total Employee Contribution"/>
                                    <field name="employer_contribution" sum="Total Employer Contribution"/>
                                    <field name="total_PF_period" sum="Tota PF Period"/>
                                    <field name="profit_share" sum="Total Profit Share"/>
                                    <field name="profit_disbursed" sum="Total Profit Disbursed"/>
                                    <field name="closing_balance" sum="Total Closing Balance"/>
                                </list>
                                <form string="Lines">
                                    <group>
                                        <group>
                                            <field name="date_from"/>
                                            <field name="date_to"/>
                                            <field name="payslip_id"/>
                                            <field name="salary_amount"/>
                                            <field name="pf_percentage"/>
                                            <field name="employee_contribution"/>

                                        </group>
                                        <group>
                                            <field name="employer_contribution"/>
                                            <field name="total_PF_period"/>
                                            <field name="profit_share"/>
                                            <field name="profit_disbursed"/>
                                            <field name="closing_balance"/>
                                        </group>
                                    </group>

                                </form>
                            </field>

                        </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_provident_fund_detail_filter" model="ir.ui.view">
            <field name="name">provident.fund.detail.search</field>
            <field name="model">provident.fund.detail</field>
            <field name="arch" type="xml">
                <search string="Search Provident Fund detail">
                    <field name="employee_id"/>
                </search>
            </field>
        </record>

        <record id="act_provident_fund_detail" model="ir.actions.act_window">
            <field name="res_model">provident.fund.detail</field>
            <field name="name">Provident Fund Detail</field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem id="menu_provident_fund_detail"
                  action="act_provident_fund_detail"
                  parent="xbo_payroll_custom.menu_payroll_operation"/>







    </data>
</odoo>